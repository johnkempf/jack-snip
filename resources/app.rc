#include <windows.h>
101 ICON "tiger-snip.ico"
201 RCDATA "samtec-logo.png"
202 RCDATA "samtec-tiger.png"
203 RCDATA "samtec-wordmark.png"
204 RCDATA "ocr/eng.traineddata"
1 RT_MANIFEST "app.manifest"
301 DIALOGEX 0, 0, 310, 230
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add palette color"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Choose a color", -1, 12, 10, 180, 12
 CONTROL "", 10, "STATIC", SS_OWNERDRAW | SS_NOTIFY, 12, 28, 192, 142
 LTEXT "Hue", -1, 12, 186, 24, 12
 CONTROL "", 18, "STATIC", SS_OWNERDRAW, 36, 174, 168, 8
 CONTROL "", 15, "msctls_trackbar32", WS_TABSTOP, 36, 184, 168, 20
 LTEXT "Preview", -1, 218, 10, 80, 12
 CONTROL "", 17, "STATIC", SS_OWNERDRAW, 218, 28, 80, 34
 LTEXT "Hex", -1, 218, 74, 80, 12
 EDITTEXT 11, 218, 88, 80, 15, ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "R", -1, 218, 115, 15, 12
 LTEXT "G", -1, 246, 115, 15, 12
 LTEXT "B", -1, 274, 115, 15, 12
 EDITTEXT 12, 218, 129, 24, 15, ES_NUMBER | WS_TABSTOP
 EDITTEXT 13, 246, 129, 24, 15, ES_NUMBER | WS_TABSTOP
 EDITTEXT 14, 274, 129, 24, 15, ES_NUMBER | WS_TABSTOP
 LTEXT "", 16, 218, 152, 80, 40
 DEFPUSHBUTTON "Add color", IDOK, 170, 207, 62, 16
 PUSHBUTTON "Cancel", IDCANCEL, 238, 207, 60, 16
END
1 VERSIONINFO
 FILEVERSION 1,0,2,0
 PRODUCTVERSION 1,0,2,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Tiger Snip - native screenshot editor\0"
   VALUE "ProductName", "Tiger Snip\0"
   VALUE "FileVersion", "1.0.2\0"
   VALUE "OriginalFilename", "Tiger Snip.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
